<Window x:Class="WPFApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ML.NET Classification Studio" Height="820" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="1. Датасет и предварительный просмотр" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Config.DatasetPath}" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4"/>
                            <Button Grid.Column="1" Content="Обзор..." Command="{Binding BrowseDatasetCommand}" Margin="6,0,0,0" Padding="10,4"/>
                        </Grid>

                        <CheckBox Content="Первая строка содержит заголовки (--has-header)"
                                  IsChecked="{Binding Config.HasHeader}"
                                  Click="HasHeader_Click" Margin="0,4,0,6"/>

                        <TextBlock Text="Предпросмотр первых строк:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding DatasetPreview}" IsReadOnly="True" Height="110"
                                 FontFamily="Consolas" FontSize="11"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 Background="#F8F9FA" Padding="4"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2. Параметры обучения (mlnet classification)" Padding="8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Колонка метки:" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4"
                                  ItemsSource="{Binding AvailableColumns}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Index"
                                  SelectedValue="{Binding Config.LabelCol}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Имя модели (--name):" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.ModelName}" Margin="0,4" Padding="4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Время обучения (сек):" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.TrainTime}" Margin="0,4" Padding="4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Логирование:" VerticalAlignment="Center" Margin="0,4"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" SelectedValue="{Binding Config.Verbosity}" SelectedValuePath="Content" Margin="0,4">
                            <ComboBoxItem Content="minimal"/>
                            <ComboBoxItem Content="detailed"/>
                            <ComboBoxItem Content="quiet"/>
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Игнор. колонки:" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Config.IgnoreCols}" ToolTip="Индексы через запятую, например: 0,2" Margin="0,4" Padding="4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Папка вывода:" VerticalAlignment="Center" Margin="0,4"/>
                        <Grid Grid.Row="5" Grid.Column="1" Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Config.OutputPath}" Padding="4"/>
                            <Button Grid.Column="1" Content="..." Command="{Binding BrowseOutputCommand}" Margin="4,0,0,0" Padding="8,2"/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <CheckBox Content="Автоматически модифицировать Program.cs после обучения"
                          IsChecked="{Binding AutoModifyConsoleApp}" Margin="4,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="▶ Обучить модель" Command="{Binding StartTrainingCommand}"
                            Height="38" FontWeight="Bold" Background="#198754" Foreground="White"/>
                    <Button Grid.Column="2" Content="■ Остановить" Command="{Binding StopTrainingCommand}"
                            Height="38" Background="#DC3545" Foreground="White"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="3. Ход выполнения (stdout / stderr)" Padding="8" Margin="0,0,0,10">
                <TextBox x:Name="LogTextBox" Text="{Binding ConsoleLog}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="12"
                         Background="#1E1E1E" Foreground="#D4D4D4"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="LogTextBox_TextChanged"/>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="4. Результаты обучения и метрики" Padding="8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0" ItemsSource="{Binding Metrics}" AutoGenerateColumns="False"
                              IsReadOnly="True" Height="130" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Метрика" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,0,6">
                            <Run Text="Лучший алгоритм: " FontWeight="SemiBold"/>
                            <Run Text="{Binding BestAlgorithm}"/>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap">
                            <Run Text="Консольный проект: " FontWeight="SemiBold"/>
                            <Run Text="{Binding GeneratedProjectPath}"/>
                        </TextBlock>
                        <Button Content="📂 Открыть папку с результатами" Command="{Binding OpenOutputFolderCommand}"
                                HorizontalAlignment="Left" Padding="12,6"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="5. Интерактивная классификация текста" Padding="8" IsEnabled="{Binding IsTrained}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             Height="54" TextWrapping="Wrap" AcceptsReturn="True" Padding="6"
                             ToolTip="Введите текст для классификации..."/>
                    <Button Grid.Row="0" Grid.Column="1" Content="Классифицировать" Command="{Binding ClassifyCommand}"
                            Margin="8,0,0,0" FontWeight="Bold"/>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#F1F3F5" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" Margin="0,0,24,0">
                                <Run Text="Предсказанный класс: " FontWeight="SemiBold"/>
                                <Run Text="{Binding PredictedClass}" Foreground="#0D6EFD" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock FontSize="14">
                                <Run Text="Уверенность (Probability): " FontWeight="SemiBold"/>
                                <Run Text="{Binding PredictedProbability}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
